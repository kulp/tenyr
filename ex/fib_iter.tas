.set ARGUMENT, 10           # set a convenience symbol

_start:
    o <- ((1 << 13) - 1)    # init stack pointer
    c <- @ARGUMENT          # set argument register
    [o] <- p + @+_ret       # store return address
    o <- o - 1              # "push" (adjust stack)
    p <- @+fib + p          # "call" (jump relative)
_ret:
    illegal                 # halt

# Computes fib(C) and stores the result in B.
fib:
    b <- 0                  # zeroth Fibonacci number
    d <- 1                  # first Fibonacci number

_loop:
    k <- c == 0             # is loop finished?
    p <- @+_done & k + p    # if so, break out

    g <- b + d              # compute next element
    b <- d                  # shift down one
    d <- g                  # "     "    "

    c <- c - 1              # tick down loop counter
    p <- p + @+_loop        # jump to top of loop

_done:
    o <- o + 1              # "pop" (adjust stack)
    p <- [o]                # jump to return address

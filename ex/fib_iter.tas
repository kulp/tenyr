.set ARGUMENT, 10

_start:
    o <- ((1 << 13) - 1)
    c <- @ARGUMENT      # argument
    [o] <- p + 2
    o <- o - 1
    p <- @+fib + p
    illegal

# Computes fib(C) and stores the result in B.
fib:
    b <- 0
    d <- 1

loop:
    k <- c == 0
    p <- @+done & k + p

    g <- b + d
    b <- d
    d <- g

    c <- c - 1
    p <- p + @+loop

done:
    o <- o + 1
    p <- [o]
